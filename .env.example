# Copy this file to .env and fill it in.

# Your Anthropic API key (https://console.anthropic.com) - powers Jarvis's brain.
ANTHROPIC_API_KEY=sk-ant-...

# --- Phone detection: Jarvis says hello when your phone enters your room ---
# Find these with:  python -m jarvis.presence --scan
# Set at least one of the three.
JARVIS_PHONE_NAME=
JARVIS_PHONE_ADDRESS=
# Optional Wi-Fi fallback (house range, not room range): your phone's fixed local IP.
JARVIS_PHONE_IP=

# Signal strength that counts as "in the room". -80 is about 10 metres, -70 about 5 m.
JARVIS_RSSI_THRESHOLD=-80
# Seconds the phone must be gone before Jarvis thinks you left.
JARVIS_AWAY_SECONDS=90
